{
  "$schema": "https://opencode.ai/schemas/opencode.json",
  "model": "big-pickle",
  "provider": {
    "opencode-zen": {
      "type": "opencode-zen",
      "apiKey": "${env:OPENCODE_ZEN_API_KEY}"
    }
  },
  "permission": {
    "allow": [
      "read(**)",
      "grep(**)",
      "glob(**)",
      "bash(./mvnw test*)",
      "bash(./mvnw verify)",
      "bash(docker compose*)"
    ],
    "deny": [
      "bash(rm *)",
      "bash(rmdir *)",
      "bash(del *)",
      "bash(rd *)",
      "bash(Remove-Item *)",
      "bash(git clean *)",
      "bash(mvn clean *)",
      "bash(./mvnw clean *)",
      "bash(git push --force*)",
      "edit(**)",
      "edit(**/secrets/**)"
    ]
  },
  "mcp": {
    "finbank-mcp": {
      "command": "python",
      "args": ["./finbank-mcp/server.py"]
    }
  }
}